---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Button from "../../components/ui/Button.astro";
import { ArrowLeftIcon } from "@radix-ui/react-icons";
import TechStack from "../../components/common/TechStack.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.data.slug || project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, desc, downloadUrl, techstack, screenshots, links } =
  project.data;
const { Content } = await render(project);
const normalizedScreenshots = screenshots?.map((screenshot, index) =>
  typeof screenshot === "string"
    ? { src: screenshot, alt: `${title} 项目截图 ${index + 1}` }
    : {
        ...screenshot,
        alt: screenshot.alt ?? `${title} 项目截图 ${index + 1}`,
      },
);
---

<Layout title={`${title} - OpenAHU Project`}>
  <div class="container mx-auto max-w-4xl px-4 py-16">
    <Button variant="ghost" size="sm" href="/" class="mb-8">
      <ArrowLeftIcon className="mr-2 h-4 w-4" /> 返回首页
    </Button>

    <div class="flex flex-col gap-8">
      <div class="space-y-4" data-motion data-motion-y="20">
        <h1 class="text-4xl font-extrabold tracking-tight lg:text-5xl">
          {title}
        </h1>
        <p class="text-xl text-muted-foreground">{desc}</p>

        <div class="flex items-center gap-4 pt-4">
          <TechStack technologies={techstack} class="flex-wrap" />
        </div>

        <div class="flex flex-wrap gap-3 pt-4">
          {
            downloadUrl !== undefined &&
              (downloadUrl ? (
                <Button href={downloadUrl} target="_blank" rel="noreferrer">
                  下载
                </Button>
              ) : (
                <Button disabled>暂无下载链接</Button>
              ))
          }
          {
            links.map((link) => (
              <Button
                variant={link.name === "Website" ? "default" : "outline"}
                href={link.url}
                target="_blank"
                rel="noreferrer"
              >
                {link.name}
              </Button>
            ))
          }
        </div>
      </div>

      {
        normalizedScreenshots && normalizedScreenshots.length > 0 && (
          <div class="grid gap-5">
            {normalizedScreenshots.map((shot) => (
              <img
                src={shot.src}
                alt={shot.alt}
                width={shot.width}
                height={shot.height}
                class="w-full rounded-3xl border border-border shadow-sm"
                decoding="async"
                loading="lazy"
                data-motion
                data-motion-trigger="view"
                data-motion-y="24"
              />
            ))}
          </div>
        )
      }

      <div
        class="markdown-content max-w-none"
        data-motion
        data-motion-trigger="view"
        data-motion-y="20"
      >
        <Content />
      </div>
    </div>
  </div>
</Layout>
