---
import { MoonIcon, SunIcon } from "@radix-ui/react-icons";
---

<button
  class="pointer-events-auto relative z-50 inline-flex h-11 w-11 items-center justify-center rounded-full transition-colors hover:bg-black/5 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-inset focus-visible:ring-foreground/20 dark:hover:bg-white/10"
  aria-label="切换至浅色模式"
  aria-pressed="true"
  data-theme-toggle
  type="button"
>
  <SunIcon className="w-5 h-5 hidden dark:block" />
  <MoonIcon className="w-5 h-5 block dark:hidden" />
</button>
