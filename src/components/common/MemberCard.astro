---
import { type CollectionEntry } from "astro:content";
import { GitHubLogoIcon, GlobeIcon } from "@radix-ui/react-icons";
import LiquidContainer from "../ui/LiquidContainer";

interface Props {
  member: CollectionEntry<"team">;
}

const { member } = Astro.props;
const { name, desc, avatar, github, website } = member.data;
---

<div
  class="liquid-card-frame group mx-auto flex w-[min(100%,16rem)] flex-col rounded-[1.75rem]"
  data-motion
  data-motion-trigger="view"
  data-motion-y="24"
>
  <LiquidContainer
    client:visible
    fill
    className="w-full rounded-[1.75rem]"
    radius={28}
    elasticity={0.3}
    touchElastic
    padding="1.125rem"
  >
    <div
      class="flex min-h-[14rem] w-full flex-col items-center justify-center text-center"
    >
      <div
        class="relative mb-3.5 h-24 w-24 overflow-hidden rounded-full border-2 border-border/50 group-hover:border-primary/30 transition-colors"
      >
        <img
          src={avatar}
          alt={`${name} 的头像`}
          class="h-full w-full object-cover"
          width="96"
          height="96"
          decoding="async"
          loading="lazy"
        />
      </div>
      <h3 class="text-lg font-bold">{name}</h3>
      <p class="mt-2 text-pretty text-sm leading-relaxed text-muted-foreground">
        {desc}
      </p>
      <div class="relative z-10 mt-3.5 flex justify-center gap-3">
        {
          github && (
            <a
              href={`https://github.com/${github}`}
              target="_blank"
              rel="noreferrer"
              aria-label={`${name} 的 GitHub 主页`}
              class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-xl text-muted-foreground transition-colors hover:bg-black/5 hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring dark:hover:bg-white/10"
            >
              <GitHubLogoIcon className="h-5 w-5" />
            </a>
          )
        }
        {
          website && (
            <a
              href={website}
              target="_blank"
              rel="noreferrer"
              aria-label={`${name} 的个人网站`}
              class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-xl text-muted-foreground transition-colors hover:bg-black/5 hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring dark:hover:bg-white/10"
            >
              <GlobeIcon className="h-5 w-5" />
            </a>
          )
        }
      </div>
    </div>
  </LiquidContainer>
</div>
