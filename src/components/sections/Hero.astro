---
import Button from "../ui/Button.astro";
import BrandName from "../common/BrandName.astro";

interface Props {
  title?: string;
  description?: string;
  cta?: { text: string; href: string };
}

const { title = "OpenAHU", description = "开放 创新 协作", cta } = Astro.props;
const titleParts = title.split(/(OpenAHU)/g).filter(Boolean);
const isHomepageWordmark = title === "OpenAHU";
---

<section
  class="mx-auto grid min-h-[calc(100svh-4rem)] w-[min(92%,72rem)] items-center gap-6 pb-16 pt-12 md:min-h-[90vh] md:py-32"
>
  <div class="flex flex-col items-center gap-4 text-center">
    <h1
      class="text-6xl font-extrabold leading-tight tracking-tighter text-foreground drop-shadow-sm md:text-8xl lg:text-9xl"
      data-motion
      data-motion-y="22"
      data-motion-scale="0.985"
    >
      {
        titleParts.map((part) =>
          part === "OpenAHU" ? (
            <BrandName gradient={isHomepageWordmark} />
          ) : (
            part
          ),
        )
      }
    </h1>
    <p
      class="max-w-[750px] text-lg text-muted-foreground sm:text-xl"
      data-motion
      data-motion-delay="300"
      data-motion-y="18"
    >
      {description}
    </p>
  </div>
  <div
    class="mx-auto flex w-full max-w-sm flex-col justify-center gap-3 px-2 min-[360px]:w-auto min-[360px]:max-w-none min-[360px]:flex-row min-[360px]:gap-4 min-[360px]:px-0"
    data-motion
    data-motion-delay="500"
    data-motion-y="18"
  >
    {
      cta && (
        <Button
          size="lg"
          href={cta.href}
          class="w-full gap-2 min-[360px]:w-auto min-[360px]:min-w-[9rem]"
        >
          {cta.text}
        </Button>
      )
    }
    <Button
      variant="outline"
      size="lg"
      href="https://github.com/OpenAHU"
      target="_blank"
      rel="noreferrer"
      class="w-full min-[360px]:w-auto min-[360px]:min-w-[9rem]"
    >
      GitHub
    </Button>
  </div>
</section>
